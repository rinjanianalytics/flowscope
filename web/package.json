{
  "name": "flowscope-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "grammar": "lezer-generator --typeScript --output src/lib/codemirror/lang-filter/parser.ts src/lib/codemirror/lang-filter/syntax.grammar",
    "api": "openapi-typescript ../crates/flowscope-sdk/openapi.json --output src/lib/api-schema.ts",
    "dev": "pnpm run grammar && next dev",
    "build": "pnpm run grammar && next build && rm -rf ../crates/flowscope-console/data/frontend && cp -r out ../crates/flowscope-console/data/frontend",
    "lint": "eslint",
    "test": "pnpm run grammar && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.61.0",
    "lz-string": "^1.5.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "sugar-date": "^2.0.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.1.3"
}
